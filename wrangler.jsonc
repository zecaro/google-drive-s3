{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "gdrive-s3",
    "main": "src/index.ts",
    "compatibility_date": "2025-01-01",
    "observability": {
        "enabled": true
    },
    "kv_namespaces": [
        { "binding": "AUTH_KV", "id": "9a80aee331c14c728ad0bcd2d12c7b20" },
        { "binding": "FOLDER_CACHE", "id": "8620bda3556742ff807743d4494823a8" }
    ],
    "vars": {
        "REGION": "auto",
        "ALLOWED_BUCKETS": "tcsspy-archive"
    }
}
